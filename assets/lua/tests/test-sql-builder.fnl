(table.insert tests {:name "sql builder parity method surface" :fn test-parity-method-surface})
(table.insert tests {:name "sql builder query facade and underscore aliases" :fn test-query-facade-and-underscore-aliases})
(table.insert tests {:name "sql builder insert on conflict and returning" :fn test-insert-on-conflict-and-returning})
(table.insert tests {:name "sql builder insert on conflict do nothing and replace alias" :fn test-insert-on-conflict-do-nothing-and-replace-alias})
(table.insert tests {:name "sql builder dml returning and delete builder" :fn test-dml-returning-and-delete-builder})
(table.insert tests {:name "sql builder term aliases isin notin and null checks" :fn test-term-aliases-isin-notin-and-null-checks})
(table.insert tests {:name "sql builder pattern operator family" :fn test-pattern-operator-family})
(table.insert tests {:name "sql builder case builder searched and simple" :fn test-case-builder-searched-and-simple})
(table.insert tests {:name "sql builder tuple and composite in" :fn test-tuple-and-composite-in})
