(table.insert tests {:name "sql builder insert from select" :fn test-insert-from-select})
(table.insert tests {:name "sql builder create and drop" :fn test-create-and-drop})
(table.insert tests {:name "sql builder function specials and windows" :fn test-function-specials-and-windows})
(table.insert tests {:name "sql builder joins set aliases and ddl builders" :fn test-joins-set-op-aliases-and-ddl-builders})
